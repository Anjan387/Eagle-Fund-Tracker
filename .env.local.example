# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (database + auth) ---
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # the "anon"/publishable key (sb_publishable_... or the JWT anon key)
SUPABASE_SERVICE_ROLE_KEY=         # the "service_role"/secret key — server only, never expose

# --- Market data (Twelve Data) ---
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=

# --- Price-refresh cron ---
# Any random string. On Vercel, the platform injects its own CRON_SECRET for
# scheduled calls; set this too so /api/refresh-prices?key=... works for manual runs.
CRON_SECRET=

# Optional, unused by the app itself (only if you run migrations from your machine):
# SUPABASE_DB_URL=
